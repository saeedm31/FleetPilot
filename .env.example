# Copy to .env (never commit .env). docker compose reads it.

# LLM: "anthropic" (API key) or "bedrock" (Amazon Bedrock, AWS role, no key)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AWS_REGION=eu-north-1
AGENT_MODEL=claude-sonnet-4-6

# Secret used to pseudonymise customer IDs. Change it; keep it in a secret store in production.
PSEUDONYM_KEY=change-me

# Budget for the copilot (EUR per month in company mode, per session in the public demo)
MONTHLY_BUDGET_EUR=10

# Set by docker compose; leave empty to run without MLflow
MLFLOW_TRACKING_URI=
LOG_LEVEL=INFO
